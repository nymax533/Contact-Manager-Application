@model IEnumerable<Contact_Manager_Application.DTOs.ContactDto>
@{
    ViewData["Title"] = "Contact Manager";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Contact Manager</h1>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Upload CSV File</h5>
                    <form asp-controller="Contacts" asp-action="Upload" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <input type="file" class="form-control" name="file" accept=".csv" required />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Upload CSV
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">CSV Format</h5>
                    <p class="mb-1"><strong>Required columns:</strong></p>
                    <ul class="small">
                        <li>Name (string)</li>
                        <li>Date of birth (date: yyyy-MM-dd)</li>
                        <li>Married (boolean: true/false)</li>
                        <li>Phone (string)</li>
                        <li>Salary (decimal)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by name, phone...">
                <button class="btn btn-outline-secondary" type="button" onclick="filterTable()">
                    <i class="bi bi-search"></i> Search
                </button>
                <button class="btn btn-outline-secondary" type="button" onclick="clearFilter()">
                    <i class="bi bi-x-circle"></i> Clear
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover" id="contactsTable">
            <thead class="table-light">
                <tr>
                    <th class="user-select-none" role="button" onclick="sortTable(0)">
                        ID <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th class="user-select-none" role="button" onclick="sortTable(1)">
                        Name <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th class="user-select-none" role="button" onclick="sortTable(2)">
                        Date of Birth <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th class="user-select-none" role="button" onclick="sortTable(3)">
                        Married <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th class="user-select-none" role="button" onclick="sortTable(4)">
                        Phone <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th class="user-select-none" role="button" onclick="sortTable(5)">
                        Salary <i class="bi bi-arrow-down-up text-muted"></i>
                    </th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in Model)
                {
                    <tr data-id="@contact.Id">
                        <td>@contact.Id</td>
                        <td class="editable" data-field="name">@contact.Name</td>
                        <td class="editable" data-field="dateOfBirth">@contact.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td class="editable" data-field="married">@(contact.Married ? "Yes" : "No")</td>
                        <td class="editable" data-field="phone">@contact.Phone</td>
                        <td class="editable" data-field="salary">@contact.Salary.ToString("N2")</td>
                        <td>
                            <button class="btn btn-sm btn-primary edit-btn" onclick="editRow(this)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-success save-btn d-none" onclick="saveRow(this)">
                                <i class="bi bi-check"></i> Save
                            </button>
                            <button class="btn btn-sm btn-secondary cancel-btn d-none" onclick="cancelEdit(this)">
                                <i class="bi bi-x"></i> Cancel
                            </button>
                            <button class="btn btn-sm btn-danger delete-btn" onclick="deleteRow(this)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No contacts found. Upload a CSV file to get started.
        </div>
    }
</div>

@section Scripts {
    <script>
        let sortDirection = [];
        let originalRowData = {};

        function sortTable(columnIndex) {
            const table = document.getElementById("contactsTable");                 
            const tbody = table.tBodies[0];
            const rows = Array.from(tbody.rows);
            const headers = table.querySelectorAll('thead th');

            if (sortDirection[columnIndex] === undefined) {
                sortDirection[columnIndex] = 'asc';
            } else {
                sortDirection[columnIndex] = sortDirection[columnIndex] === 'asc' ? 'desc' : 'asc';
            }


            headers.forEach((header, index) => {
                const icon = header.querySelector('i');
                if (icon && index < 6) {
                    icon.className = 'bi bi-arrow-down-up text-muted';
                    if (index === columnIndex) {
                        icon.className = sortDirection[columnIndex] === 'asc' 
                            ? 'bi bi-sort-up text-primary' 
                            : 'bi bi-sort-down text-primary';
                    }
                }
            });

            rows.sort((a, b) => {
                let aVal = a.cells[columnIndex].textContent.trim();
                let bVal = b.cells[columnIndex].textContent.trim();

                if (columnIndex === 0 || columnIndex === 5) { 
                    aVal = parseFloat(aVal.replace(/[^0-9.-]+/g, ""));
                    bVal = parseFloat(bVal.replace(/[^0-9.-]+/g, ""));
                } else if (columnIndex === 2) { 
                    aVal = new Date(aVal);
                    bVal = new Date(bVal);
                }

                if (aVal < bVal) return sortDirection[columnIndex] === 'asc' ? -1 : 1;
                if (aVal > bVal) return sortDirection[columnIndex] === 'asc' ? 1 : -1;
                return 0;
            });

            rows.forEach(row => tbody.appendChild(row));
        }

        function filterTable() {
            const input = document.getElementById("searchInput");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("contactsTable");
            const rows = table.getElementsByTagName("tr");

            for (let i = 1; i < rows.length; i++) {
                let row = rows[i];
                let text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? "" : "none";
            }
        }

        function clearFilter() {
            document.getElementById("searchInput").value = "";
            filterTable();
        }

        function editRow(btn) {
            const row = btn.closest('tr');
            const editableCells = row.querySelectorAll('.editable');
            const id = row.getAttribute('data-id');

            originalRowData[id] = {};
            editableCells.forEach(cell => {
                const field = cell.getAttribute('data-field');
                originalRowData[id][field] = cell.textContent;

                let value = cell.textContent.trim();
                let input;

                if (field === 'married') {
                    input = document.createElement('select');
                    input.className = 'form-select form-select-sm';
                    input.innerHTML = '<option value="true">Yes</option><option value="false">No</option>';
                    input.value = value === 'Yes' ? 'true' : 'false';
                } else if (field === 'dateOfBirth') {
                    input = document.createElement('input');
                    input.type = 'date';
                    input.className = 'form-control form-control-sm';
                    input.value = value;
                } else if (field === 'salary') {
                    input = document.createElement('input');
                    input.type = 'number';
                    input.step = '0.01';
                    input.className = 'form-control form-control-sm';
                    input.value = value.replace(/[^0-9.-]+/g, "");
                } else {
                    input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'form-control form-control-sm';
                    input.value = value;
                }

                cell.innerHTML = '';
                cell.appendChild(input);
            });

            row.querySelector('.edit-btn').classList.add('d-none');
            row.querySelector('.delete-btn').classList.add('d-none');
            row.querySelector('.save-btn').classList.remove('d-none');
            row.querySelector('.cancel-btn').classList.remove('d-none');
        }

        async function saveRow(btn) {
            const row = btn.closest('tr');
            const id = parseInt(row.getAttribute('data-id'));
            const editableCells = row.querySelectorAll('.editable');

            const data = { id: id };
            editableCells.forEach(cell => {
                const field = cell.getAttribute('data-field');
                const input = cell.querySelector('input, select');
                
                if (field === 'married') {
                    data[field] = input.value === 'true';
                } else if (field === 'dateOfBirth') {
                    data[field] = input.value;
                } else if (field === 'salary') {
                    data[field] = parseFloat(input.value);
                } else {
                    data[field] = input.value;
                }
            });

            try {
                const response = await fetch('/Contacts/Update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (result.success) {
                    editableCells.forEach(cell => {
                        const field = cell.getAttribute('data-field');
                        const input = cell.querySelector('input, select');
                        let displayValue;

                        if (field === 'married') {
                            displayValue = input.value === 'true' ? 'Yes' : 'No';
                        } else if (field === 'salary') {
                            displayValue = parseFloat(input.value).toFixed(2);
                        } else {
                            displayValue = input.value;
                        }

                        cell.textContent = displayValue;
                    });

                    row.querySelector('.edit-btn').classList.remove('d-none');
                    row.querySelector('.delete-btn').classList.remove('d-none');
                    row.querySelector('.save-btn').classList.add('d-none');
                    row.querySelector('.cancel-btn').classList.add('d-none');

                    showAlert('Contact updated successfully', 'success');
                } else {
                    showAlert('Failed to update contact: ' + result.message, 'danger');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('An error occurred while updating the contact', 'danger');
            }
        }

        function cancelEdit(btn) {
            const row = btn.closest('tr');
            const id = row.getAttribute('data-id');
            const editableCells = row.querySelectorAll('.editable');

            editableCells.forEach(cell => {
                const field = cell.getAttribute('data-field');
                cell.textContent = originalRowData[id][field];
            });

            row.querySelector('.edit-btn').classList.remove('d-none');
            row.querySelector('.delete-btn').classList.remove('d-none');
            row.querySelector('.save-btn').classList.add('d-none');
            row.querySelector('.cancel-btn').classList.add('d-none');
        }

        async function deleteRow(btn) {
            if (!confirm('Are you sure you want to delete this contact?')) {
                return;
            }

            const row = btn.closest('tr');
            const id = parseInt(row.getAttribute('data-id'));

            try {
                const response = await fetch(`/Contacts/Delete?id=${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (result.success) {
                    row.remove();
                    showAlert('Contact deleted successfully', 'success');
                } else {
                    showAlert('Failed to delete contact: ' + result.message, 'danger');
                }
            } catch (error) {
                console.error('Error:', error);
                showAlert('An error occurred while deleting the contact', 'danger');
            }
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            document.querySelector('.container').insertBefore(alertDiv, document.querySelector('.container').firstChild);
            
            setTimeout(() => alertDiv.remove(), 5000);
        }

        document.getElementById("searchInput").addEventListener("keyup", function(event) {
            if (event.key === "Enter") {
                filterTable();
            }
        });
    </script>
}
